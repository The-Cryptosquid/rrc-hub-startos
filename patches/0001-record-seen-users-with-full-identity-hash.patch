diff --git i/rrcd/seen.py w/rrcd/seen.py
new file mode 100644
index 0000000..a38ebed
--- /dev/null
+++ w/rrcd/seen.py
@@ -0,0 +1,74 @@
+from __future__ import annotations
+
+import json
+import os
+import threading
+import time
+from typing import TYPE_CHECKING
+
+if TYPE_CHECKING:
+    from .service import HubService
+
+# Keep the most recently seen identities only, so the file stays small on a
+# busy hub.
+MAX_SEEN_USERS = 500
+
+
+class SeenUsers:
+    """
+    Records the full identity hash and last nickname of every peer that
+    completes HELLO, in a JSON file (config key ``seen_users_path``).
+
+    rrcd logs only a 12-character hash prefix, which is not enough to name a
+    user in ``trusted_identities`` or a room's operator/voice/ban lists. This
+    file lets an operator pick a user who has connected instead of asking them
+    for their identity hash. Disabled when ``seen_users_path`` is unset.
+    """
+
+    def __init__(self, hub: HubService) -> None:
+        self.hub = hub
+        self.log = hub.log
+        self._lock = threading.Lock()
+
+    def record(self, peer_hash: bytes | None, nick: str | None) -> None:
+        path = self.hub.config.seen_users_path
+        if not path or not isinstance(peer_hash, (bytes, bytearray)):
+            return
+        path = os.path.expanduser(str(path))
+        try:
+            with self._lock:
+                try:
+                    with open(path, encoding="utf-8") as f:
+                        data = json.load(f)
+                except FileNotFoundError:
+                    data = {}
+                except Exception:
+                    self.log.warning("Unreadable seen-users file, starting over: %s", path)
+                    data = {}
+                users = data.get("users") if isinstance(data, dict) else None
+                if not isinstance(users, dict):
+                    users = {}
+
+                key = bytes(peer_hash).hex()
+                entry = users.get(key) if isinstance(users.get(key), dict) else {}
+                now = time.time()
+                entry.setdefault("first_seen", now)
+                entry["last_seen"] = now
+                if isinstance(nick, str) and nick:
+                    entry["nick"] = nick
+                users[key] = entry
+
+                if len(users) > MAX_SEEN_USERS:
+                    newest = sorted(
+                        users.items(),
+                        key=lambda kv: float(kv[1].get("last_seen", 0)),
+                        reverse=True,
+                    )[:MAX_SEEN_USERS]
+                    users = dict(newest)
+
+                tmp = f"{path}.tmp"
+                with open(tmp, "w", encoding="utf-8") as f:
+                    json.dump({"users": users}, f, indent=1, sort_keys=True)
+                os.replace(tmp, path)
+        except Exception:
+            self.log.exception("Failed to record seen user")
